@model IEnumerable<_25DH110915_LTW.Models.Product>

@{
    ViewBag.Title = "Danh sách Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white" style="padding: 10px; margin-bottom: 20px;">DANH SÁCH SẢN PHẨM</h2>

<p style="margin-bottom: 15px;">
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped table-hover">
    <thead class="bg-info text-white">
        <tr>
            <th class="text-center">Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th class="text-right">Đơn giá</th>
            <th class="text-center">Số lượng</th>
            <th>Danh mục</th>
            <th class="text-center" style="width: 200px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center" style="vertical-align: middle;">
                    <!-- Dùng thẻ img để biến link text thành hình ảnh thật -->
                    <img src="@item.ProductImage" alt="@item.ProductName" style="max-height: 80px; max-width: 80px; object-fit: contain;" />
                </td>
                <td style="vertical-align: middle;">
                    <strong>@item.ProductName</strong>
                </td>
                <td class="text-right" style="vertical-align: middle; color: red; font-weight: bold;">
                    @item.ProductPrice.ToString("N0") đ
                </td>
                <td class="text-center" style="vertical-align: middle;">
                    @item.Quantity
                </td>
                <td style="vertical-align: middle;">
                    @item.Category.CategoryName
                </td>
                <td class="text-center" style="vertical-align: middle;">
                    <!-- Format các link thành nút bấm Bootstrap -->
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
