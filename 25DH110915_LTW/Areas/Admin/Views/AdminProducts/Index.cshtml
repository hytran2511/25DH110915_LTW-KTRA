@model IEnumerable<_25DH110915_LTW.Models.Product>

@{
    ViewBag.Title = "Quản lý hàng hóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #dff0d8; padding: 10px 15px; font-size: 26px; font-weight: 400; color: #333; margin-bottom: 15px;">
    DANH SÁCH HÀNG HÓA (SẢN PHẨM)
</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p class="mb-3">
    @Html.ActionLink("Thêm mới hàng hóa", "Create", null, new { @class = "btn btn-primary" })
    <a href="@Url.Action("Index", "Inventory", new { area = "Admin" })" class="btn btn-info text-white ms-2">
        <i class="fa fa-warehouse me-1"></i> Thống kê Kho hàng (Tồn kho / Cần nhập)
    </a>
</p>

<!-- Trang Index chỉ hiện 5 cột dữ liệu chính: Tên, Ảnh, Giá, Số lượng tồn, Chủng loại -->
<table class="table table-bordered table-striped table-hover align-middle">
    <thead style="background-color: #dff0d8; color: #333;">
        <tr>
            <th class="text-center" style="width: 110px;">Hình ảnh</th>
            <th>Tên hàng hóa</th>
            <th class="text-end" style="width: 150px;">Đơn giá</th>
            <th class="text-center" style="width: 140px;">Số lượng tồn</th>
            <th style="width: 180px;">Chủng loại</th>
            <th class="text-center" style="width: 210px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string imgSrc = !string.IsNullOrEmpty(item.ProductImage)
                ? (item.ProductImage.StartsWith("http") || item.ProductImage.StartsWith("/") || item.ProductImage.StartsWith("~")
                    ? Url.Content(item.ProductImage)
                    : Url.Content("~/Images/" + item.ProductImage))
                : "https://via.placeholder.com/80?text=No+Image";

            <tr style="background-color: #d9edf7;">
                <td class="text-center">
                    <img src="@imgSrc" alt="@item.ProductName" style="max-height: 75px; max-width: 75px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/80?text=No+Image'" />
                </td>
                <td>
                    <strong>@item.ProductName</strong>
                </td>
                <td class="text-end text-danger fw-bold">
                    @item.ProductPrice.ToString("N0") đ
                </td>
                <td class="text-center fw-bold">
                    @if ((item.Quantity ?? 0) > 0)
                    {
                        <span class="text-success">@item.Quantity</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">0 (Cần nhập)</span>
                    }
                </td>
                <td>
                    @(item.Category != null ? item.Category.CategoryName : "")
                </td>
                <td class="text-center">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-sm text-white" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
