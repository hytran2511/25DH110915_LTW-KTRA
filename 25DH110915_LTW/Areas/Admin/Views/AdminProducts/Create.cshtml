@model _25DH110915_LTW.Models.Product

@{
    ViewBag.Title = "Thêm mới Hàng hóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card mt-3" style="max-width: 820px; margin: 0 auto; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: none;">
    <div class="card-header bg-success text-white text-center" style="font-size: 1.25rem; font-weight: bold; text-transform: uppercase;">
        <i class="fa fa-plus-circle"></i> THÊM MỚI HÀNG HÓA (SẢN PHẨM)
    </div>
    <div class="card-body p-4">
        @using (Html.BeginForm("Create", "AdminProducts", new { area = "Admin" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger alert alert-danger" })

                <div class="mb-3">
                    <label class="form-label fw-bold">Chủng loại / Danh mục <span class="text-danger">*</span></label>
                    @Html.DropDownList("CategoryID", null, "-- Chọn danh mục --", htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên hàng hóa <span class="text-danger">*</span></label>
                    @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên sản phẩm (2 - 200 ký tự)..." } })
                    @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger small" })
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.ProductPrice, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1000", step = "1000" } })
                        @Html.ValidationMessageFor(model => model.ProductPrice, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                        @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Upload ảnh sản phẩm</label>
                    <input type="file" name="uploadImage" class="form-control mb-2" accept="image/*" />
                    <small class="text-muted">Hoặc nhập tên file ảnh có sẵn trong thư mục Images / URL ảnh:</small>
                    @Html.EditorFor(model => model.ProductImage, new { htmlAttributes = new { @class = "form-control form-control-sm mt-1", placeholder = "VD: tam-ly.jpg hoặc https://..." } })
                    @Html.ValidationMessageFor(model => model.ProductImage, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mô tả chi tiết <span class="text-danger">*</span></label>
                    @Html.TextAreaFor(model => model.ProductDecription, new { @class = "form-control", rows = "4", placeholder = "Nhập mô tả chi tiết sản phẩm..." })
                    @Html.ValidationMessageFor(model => model.ProductDecription, "", new { @class = "text-danger small" })
                </div>

                <div class="text-center mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-success px-5 fw-bold"><i class="fa fa-save"></i> Lưu Hàng Hóa</button>
                    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
