@model _25DH110915_LTW.Models.Product

@{
    ViewBag.Title = "Chỉnh sửa Hàng hóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string imgSrc = Model != null && !string.IsNullOrEmpty(Model.ProductImage)
        ? (Model.ProductImage.StartsWith("http") || Model.ProductImage.StartsWith("/") || Model.ProductImage.StartsWith("~")
            ? Url.Content(Model.ProductImage)
            : Url.Content("~/Images/" + Model.ProductImage))
        : "https://via.placeholder.com/100?text=No+Image";
}

<div class="card mt-3" style="max-width: 820px; margin: 0 auto; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: none;">
    <div class="card-header bg-warning text-dark text-center" style="font-size: 1.25rem; font-weight: bold; text-transform: uppercase;">
        <i class="fa fa-edit"></i> CẬP NHẬT HÀNG HÓA: @Model.ProductName
    </div>
    <div class="card-body p-4">
        @using (Html.BeginForm("Edit", "AdminProducts", new { area = "Admin" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ProductID)

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger alert alert-danger" })

                <div class="mb-3">
                    <label class="form-label fw-bold">Chủng loại / Danh mục <span class="text-danger">*</span></label>
                    @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên hàng hóa <span class="text-danger">*</span></label>
                    @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger small" })
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.ProductPrice, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1000", step = "1000" } })
                        @Html.ValidationMessageFor(model => model.ProductPrice, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                        @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Hình ảnh hiện tại & Upload ảnh mới</label>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <img src="@imgSrc" alt="@Model.ProductName" style="height: 80px; width: 80px; object-fit: contain; border: 1px solid #ddd; border-radius: 4px;" onerror="this.src='https://via.placeholder.com/80?text=No+Image'" />
                        <div class="flex-grow-1">
                            <input type="file" name="uploadImage" class="form-control mb-1" accept="image/*" />
                            @Html.EditorFor(model => model.ProductImage, new { htmlAttributes = new { @class = "form-control form-control-sm", placeholder = "Tên file ảnh hoặc URL..." } })
                        </div>
                    </div>
                    @Html.ValidationMessageFor(model => model.ProductImage, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mô tả chi tiết <span class="text-danger">*</span></label>
                    @Html.TextAreaFor(model => model.ProductDecription, new { @class = "form-control", rows = "4" })
                    @Html.ValidationMessageFor(model => model.ProductDecription, "", new { @class = "text-danger small" })
                </div>

                <div class="text-center mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-warning px-5 fw-bold"><i class="fa fa-save"></i> Lưu Thay Đổi</button>
                    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
