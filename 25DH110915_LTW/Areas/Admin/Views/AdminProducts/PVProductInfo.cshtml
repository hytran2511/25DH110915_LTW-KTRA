@model _25DH110915_LTW.Models.Product

<head>
    <style>
        img {
            height: 200px;
            max-width: 200px;
        }
    </style>
</head>

<div class="container-fluid">
    <dl class="dl-horizontal">
        <dt>Tên sản phẩm</dt>
        <dd>@Html.DisplayFor(model => model.ProductName)</dd>

        <dt> Mô tả</dt>
        <dd> @Html.DisplayFor(model => model.ProductDecription)</dd>

        <dt> Đơn giá</dt>
        <dd>@Html.DisplayFor(model => model.ProductPrice) </dd>

        <dt>Hình ảnh</dt>
        <dd>
            <img src="@Model.ProductImage" style="max-width: 250px; height: auto;" alt="Ảnh sản phẩm" />
        </dd>

        <dt>Danh mục</dt>
        <dd> @Html.DisplayFor(model => model.Category.CategoryName) </dd>

        <dt style="padding:10px"></dt>
    </dl>
</div>