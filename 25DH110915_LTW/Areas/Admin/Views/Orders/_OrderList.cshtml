@model IEnumerable<_25DH110915_LTW.Models.Order>

<table class="table table-bordered table-striped mt-3">
    <thead class="bg-primary text-white">
        <tr>
            <th class="text-center">Mã Đơn</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái TT</th>
            <th>Giao hàng</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center font-weight-bold">#@item.OrderID</td>
                    <td>@String.Format("{0:dd/MM/yyyy HH:mm}", item.OrderDate)</td>
                    <td class="text-danger font-weight-bold">@item.TotalAmount.ToString("N0") đ</td>
                    <td>@item.PaymentStatus</td>
                    <td>@item.DeliveryMethod</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Khách hàng này chưa có đơn hàng nào.</td>
            </tr>
        }
    </tbody>
</table>
