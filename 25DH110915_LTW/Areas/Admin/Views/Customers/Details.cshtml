@model _25DH110915_LTW.Models.Customer

@{
    ViewBag.Title = "Chi tiết Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #dff0d8; padding: 10px 15px; font-size: 26px; font-weight: 400; color: #333; margin-bottom: 15px;">
    THÔNG TIN CHI TIẾT KHÁCH HÀNG
</h2>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p class="mb-2"><strong>Mã khách hàng:</strong> #@Model.CustomerID</p>
                <p class="mb-2"><strong>Họ và tên:</strong> @Model.CustomerName</p>
                <p class="mb-2"><strong>Số điện thoại:</strong> @Model.CustomerPhone</p>
            </div>
            <div class="col-md-6">
                <p class="mb-2"><strong>Email:</strong> @Model.CustomerEmail</p>
                <p class="mb-2"><strong>Địa chỉ:</strong> @Model.CustomerAddress</p>
                <p class="mb-0"><strong>Tên đăng nhập:</strong> @Model.Username</p>
            </div>
        </div>
    </div>
</div>

<!-- Nhúng Partial View Danh sách đơn hàng (_OrderList) vào trang Detail của Customer -->
<div class="mt-4">
    <h4 class="fw-bold text-success mb-2">DANH SÁCH ĐƠN HÀNG CỦA KHÁCH HÀNG</h4>
    @Html.Partial("~/Areas/Admin/Views/Orders/_OrderList.cshtml", Model.Orders)
</div>

<p class="mt-3">
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
</p>
