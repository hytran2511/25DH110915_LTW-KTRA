@model IEnumerable<_25DH110915_LTW.Models.User>

@{
    ViewBag.Title = "Quản lý Người dùng (Quản trị viên)";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #dff0d8; padding: 10px 15px; font-size: 26px; font-weight: 400; color: #333; margin-bottom: 15px;">
    DANH SÁCH TÀI KHOẢN NGƯỜI QUẢN TRỊ
</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p class="mb-3">
    @Html.ActionLink("Thêm mới người quản trị", "Create", null, new { @class = "btn btn-primary" })
</p>

<!-- Bảng User có < 5 cột nên bỏ chức năng Detail theo đúng Barem Excel -->
<table class="table table-bordered table-striped table-hover align-middle">
    <thead style="background-color: #dff0d8; color: #333;">
        <tr>
            <th>Tên đăng nhập (Username)</th>
            <th>Vai trò (Role)</th>
            <th class="text-center" style="width: 220px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr style="background-color: #d9edf7;">
                <td><strong>@item.Username</strong></td>
                <td>@item.UserRole</td>
                <td class="text-center">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.Username }, new { @class = "btn btn-warning btn-sm me-1" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.Username }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
