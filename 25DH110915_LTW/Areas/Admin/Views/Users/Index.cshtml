@model IEnumerable<_25DH110915_LTW.Models.User>

@{
    ViewBag.Title = "Quản lý Tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white" style="padding: 10px; margin-bottom: 20px;">QUẢN LÝ TÀI KHOẢN ADMIN</h2>

<p style="margin-bottom: 15px;">
    @Html.ActionLink("Thêm mới Admin", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped table-hover">
    <thead class="bg-info text-white">
        <tr>
            <th>Tên đăng nhập (Username)</th>
            <th>Vai trò (Role)</th>
            <th class="text-center" style="width: 250px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="vertical-align: middle;"><strong>@item.Username</strong></td>
                <td style="vertical-align: middle;">@item.UserRole</td>
                <td class="text-center" style="vertical-align: middle;">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.Username }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.Username }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.Username }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
