@model _25DH110915_LTW.Models.User

@{
    ViewBag.Title = "Chi tiết Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card mt-4" style="max-width: 500px; margin: 0 auto; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
    <div class="card-header bg-info text-white text-center" style="font-size: 1.25rem; font-weight: bold;">
        THÔNG TIN TÀI KHOẢN
    </div>
    <div class="card-body">
        <table class="table table-bordered mt-3">
            <tbody>
                <tr>
                    <th class="bg-light" style="width: 40%;">Tên đăng nhập</th>
                    <td class="fw-bold text-primary">@Html.DisplayFor(model => model.Username)</td>
                </tr>
                <tr>
                    <th class="bg-light">Mật khẩu</th>
                    <td>••••••••</td>
                </tr>
                <tr>
                    <th class="bg-light">Vai trò</th>
                    <td>
                        <span class="badge bg-secondary" style="font-size: 0.9rem;">@Html.DisplayFor(model => model.UserRole)</span>
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="text-center mt-4">
            @Html.ActionLink("Sửa Tài khoản", "Edit", new { id = Model.Username }, new { @class = "btn btn-warning px-4" })
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
        </div>
    </div>
</div>