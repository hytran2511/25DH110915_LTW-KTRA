@model _25DH110915_LTW.Models.User

@{
    ViewBag.Title = "Chỉnh sửa Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card mt-4" style="max-width: 600px; margin: 0 auto; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
    <div class="card-header bg-warning text-dark text-center" style="font-size: 1.25rem; font-weight: bold;">
        CHỈNH SỬA TÀI KHOẢN: @Model.Username
    </div>
    <div class="card-body" style="padding: 2rem;">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.Username)

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Mật khẩu mới</label>
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", type = "password" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-bold">Vai trò</label>
                    <select name="UserRole" class="form-select form-control">
                        <option value="Admin" @(Model.UserRole == "Admin" ? "selected" : "")>Admin (Quản trị viên)</option>
                        <option value="Customer" @(Model.UserRole == "Customer" ? "selected" : "")>Customer (Khách hàng)</option>
                    </select>
                    @Html.ValidationMessageFor(model => model.UserRole, "", new { @class = "text-danger" })
                </div>

                <div class="form-group text-center">
                    <button type="submit" class="btn btn-warning px-4 fw-bold">Lưu Thay Đổi</button>
                    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
                </div>
            </div>
        }
    </div>
</div>