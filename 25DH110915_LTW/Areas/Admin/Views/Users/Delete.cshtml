@model _25DH110915_LTW.Models.User

@{
    ViewBag.Title = "Xóa Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card mt-4 border-danger" style="max-width: 500px; margin: 0 auto; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
    <div class="card-header bg-danger text-white text-center" style="font-size: 1.25rem; font-weight: bold;">
        XÓA TÀI KHOẢN
    </div>
    <div class="card-body text-center" style="padding: 2rem;">
        <h4 class="text-danger mb-4">Bạn có chắc chắn muốn xóa tài khoản này?</h4>

        <div class="alert alert-warning text-start">
            <strong>Username:</strong> @Html.DisplayFor(model => model.Username) <br />
            <strong>Vai trò:</strong> @Html.DisplayFor(model => model.UserRole)
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="mt-4">
                <button type="submit" class="btn btn-danger px-4 fw-bold">Xác nhận Xóa</button>
                @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
            </div>
        }
    </div>
</div>