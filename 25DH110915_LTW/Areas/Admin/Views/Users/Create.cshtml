@model _25DH110915_LTW.Models.User

@{
    ViewBag.Title = "Thêm mới Người quản trị";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #dff0d8; padding: 10px 15px; font-size: 26px; font-weight: 400; color: #333; margin-bottom: 20px;">
    THÊM MỚI TÀI KHOẢN NGƯỜI QUẢN TRỊ
</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="max-width: 600px; background: #f9f9f9; padding: 24px; border-radius: 8px; border: 1px solid #ddd;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            <label class="form-label fw-bold">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
            @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control", placeholder = "Từ 3 - 50 ký tự..." } })
            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu (Password) <span class="text-danger">*</span></label>
            @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", type = "password", placeholder = "Từ 3 - 50 ký tự..." } })
            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Vai trò (User Role) <span class="text-danger">*</span></label>
            <select name="UserRole" class="form-select">
                <option value="Admin" selected>Admin (Người quản trị)</option>
            </select>
            @Html.ValidationMessageFor(model => model.UserRole, "", new { @class = "text-danger small" })
        </div>

        <div>
            <button type="submit" class="btn btn-primary px-4">Lưu tài khoản</button>
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
