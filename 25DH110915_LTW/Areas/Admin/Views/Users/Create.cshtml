@model _25DH110915_LTW.Models.User

@{
    ViewBag.Title = "Thêm mới Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white" style="padding: 10px; margin-bottom: 20px;">THÊM MỚI TÀI KHOẢN ADMIN</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="max-width: 600px; background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #ddd;">
        <!-- Vùng hiển thị thông báo lỗi chung -->
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label class="control-label col-md-12" style="font-weight: bold;">Tên đăng nhập (Username)</label>
            <div class="col-md-12">
                @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên đăng nhập..." } })
                @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label class="control-label col-md-12" style="font-weight: bold;">Mật khẩu (Password)</label>
            <div class="col-md-12">
                <!-- Chuyển type thành password để ẩn ký tự khi gõ -->
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", type = "password", placeholder = "Nhập mật khẩu..." } })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label class="control-label col-md-12" style="font-weight: bold;">Vai trò (User Role)</label>
            <div class="col-md-12">
                <!-- Thay ô nhập tay bằng Dropdown List để chọn cho chính xác, tránh lỗi nhập quá ký tự -->
                <select name="UserRole" class="form-control">
                    <option value="Admin">Admin (Quản trị viên)</option>
                    <option value="Customer">Customer (Khách hàng)</option>
                </select>
                @Html.ValidationMessageFor(model => model.UserRole, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-top: 25px;">
            <div class="col-md-12">
                <input type="submit" value="Tạo tài khoản" class="btn btn-primary" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
}