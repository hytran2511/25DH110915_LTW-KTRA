<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị hệ thống</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

    <style>
        body {
            padding-top: 65px;
            background-color: #ffffff;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .admin-navbar {
            background-color: #222222;
            border-bottom: 1px solid #080808;
            min-height: 55px;
            padding: 5px 25px;
        }

        .fastor-logo {
            background-color: #ffffff;
            color: #111111 !important;
            font-weight: 900;
            font-size: 22px;
            letter-spacing: 1px;
            padding: 3px 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            margin-right: 20px;
            border-radius: 2px;
        }

        .fastor-logo .o-dot {
            color: #8cc63f;
        }

        .admin-navbar .nav-link {
            color: #9d9d9d !important;
            font-size: 15px;
            padding: 10px 15px !important;
            transition: color 0.2s;
        }

        .admin-navbar .nav-link:hover,
        .admin-navbar .nav-link:focus,
        .admin-navbar .nav-item:hover > .nav-link {
            color: #ffffff !important;
        }

        /* Hover mở sub-menu theo yêu cầu Excel nhưng vẫn cho phép click trực tiếp vào menu chính */
        .admin-navbar .nav-item.dropdown:hover > .dropdown-menu {
            display: block;
            margin-top: 0;
        }

        .admin-navbar .dropdown-menu {
            background-color: #2c2c2c;
            border: 1px solid #444;
            border-radius: 0 0 4px 4px;
            padding: 5px 0;
        }

        .admin-navbar .dropdown-item {
            color: #d0d0d0;
            font-size: 14px;
            padding: 8px 18px;
        }

        .admin-navbar .dropdown-item:hover {
            background-color: #337ab7;
            color: #ffffff;
        }

        .main-content {
            flex: 1;
            padding: 20px 35px;
        }

        .admin-footer {
            background-color: #cccccc;
            color: #333333;
            padding: 28px 45px;
            margin-top: 40px;
        }

        .admin-footer .contact-title {
            font-size: 20px;
            font-weight: 500;
            margin-bottom: 5px;
        }
    </style>
</head>
<body>
    <!-- THANH MENU ADMIN GIỐNG FILE PPT + SUB-MENU THEO FILE EXCEL -->
    <nav class="navbar navbar-expand-lg navbar-dark admin-navbar fixed-top">
        <div class="container-fluid">
            <a class="fastor-logo" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                FAST<span class="o-dot">O</span>R
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "Admin" })">HomeAdmin</a>
                    </li>

                    <!-- Sub-menu Quản lý danh mục -->
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="@Url.Action("Index", "Categories", new { area = "Admin" })">Danh mục</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Categories", new { area = "Admin" })"><i class="fa fa-list me-2"></i>Quản lý danh mục</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Create", "Categories", new { area = "Admin" })"><i class="fa fa-plus me-2"></i>Thêm danh mục mới</a></li>
                        </ul>
                    </li>

                    <!-- Sub-menu Quản lý hàng hóa (Gom Product, Product Detail & Kho hàng) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="@Url.Action("Index", "AdminProducts", new { area = "Admin" })">Sản phẩm</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "AdminProducts", new { area = "Admin" })"><i class="fa fa-box me-2"></i>Quản lý hàng hóa (Product)</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Create", "AdminProducts", new { area = "Admin" })"><i class="fa fa-plus-circle me-2"></i>Thêm hàng hóa mới</a></li>
                            <li><hr class="dropdown-divider bg-secondary" /></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Inventory", new { area = "Admin" })"><i class="fa fa-warehouse me-2"></i>Quản lý kho hàng (Tồn kho / Cần nhập)</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Customers", new { area = "Admin" })">Khách hàng</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Orders", new { area = "Admin" })">Đơn hàng</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Users", new { area = "Admin" })">Tài khoản</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Inventory", new { area = "Admin" })">Kho hàng</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="nav-link text-warning">
                            <i class="fa fa-store me-1"></i> Trang khách hàng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Logout", "Account", new { area = "" })" class="nav-link text-danger">
                            <i class="fa fa-sign-out-alt me-1"></i> Đăng xuất
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG CHÍNH -->
    <div class="container-fluid main-content">
        @RenderBody()
    </div>

    <!-- FOOTER GIỐNG FILE PPT -->
    <footer class="admin-footer">
        <div class="row align-items-center">
            <div class="col-md-6">
                <p class="mb-1">© @DateTime.Now.Year - Tên ứng dụng: 25DH110915_LTW</p>
                <p class="mb-0 small">Sinh viên thực hiện: <strong>Trần Gia Hy</strong> - MSSV: <strong>25DH110915</strong></p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="contact-title">Contact</div>
                <div>Tên các thành viên trong nhóm: Trần Gia Hy (25DH110915)</div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
