@{
    ViewBag.Title = "Quản lý Kho Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var inStockList = ViewBag.InStock as List<_25DH110915_LTW.Models.Product>;
    var outOfStockList = ViewBag.OutOfStock as List<_25DH110915_LTW.Models.Product>;
}

<h2 style="background-color: #dff0d8; padding: 10px 15px; font-size: 26px; font-weight: 400; color: #333;">
    QUẢN LÝ & THỐNG KÊ KHO HÀNG
</h2>

<!-- Phần 1: Danh sách hàng cần nhập (Số lượng tồn = 0) -->
<div class="mt-4 mb-5">
    <h4 class="text-danger fw-bold mb-3">
        <i class="fa fa-exclamation-circle me-2"></i>1. Danh sách hàng cần nhập (Số lượng tồn = 0)
        <span class="badge bg-danger ms-2">@(outOfStockList != null ? outOfStockList.Count : 0) SP</span>
    </h4>
    @Html.Partial("_InventoryProductList", outOfStockList)
</div>

<!-- Phần 2: Danh sách hàng tồn (Số lượng tồn > 0) -->
<div class="mb-4">
    <h4 class="text-success fw-bold mb-3">
        <i class="fa fa-boxes me-2"></i>2. Danh sách hàng tồn (Số lượng tồn > 0)
        <span class="badge bg-success ms-2">@(inStockList != null ? inStockList.Count : 0) SP</span>
    </h4>
    @Html.Partial("_InventoryProductList", inStockList)
</div>
