@{
    ViewBag.Title = "Quản lý Kho Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // Nhận dữ liệu từ ViewBag
    var inStockList = ViewBag.InStock as List<_25DH110915_LTW.Models.Product>;
    var outOfStockList = ViewBag.OutOfStock as List<_25DH110915_LTW.Models.Product>;
}

<h2 class="bg-primary text-white" style="padding: 10px;">THỐNG KÊ KHO HÀNG</h2>

<div class="row" style="margin-top: 20px;">
    <!-- Phần 1: Danh sách Hàng Tồn (Số lượng > 0) -->
    <div class="col-md-6">
        <h4 class="text-success font-weight-bold">Danh sách hàng tồn (Còn hàng)</h4>
        <table class="table table-bordered table-striped">
            <thead class="bg-success text-white">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Hình ảnh</th>
                    <th class="text-center">Số lượng tồn</th>
                </tr>
            </thead>
            <tbody>
                @if (inStockList != null && inStockList.Any())
                {
                    foreach (var item in inStockList)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td><img src="@item.ProductImage" style="max-height: 40px;" /></td>
                            <!-- Nhớ đổi tên cột StockQuantity nếu DB của bạn dùng tên khác -->
                            <td class="text-center font-weight-bold text-success">@item.Quantity</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center">Không có sản phẩm nào tồn kho.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phần 2: Danh sách Hàng Cần Nhập (Số lượng = 0) -->
    <div class="col-md-6">
        <h4 class="text-danger font-weight-bold">Danh sách hàng cần nhập (Hết hàng)</h4>
        <table class="table table-bordered table-striped">
            <thead class="bg-danger text-white">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Hình ảnh</th>
                    <th class="text-center">Tình trạng</th>
                </tr>
            </thead>
            <tbody>
                @if (outOfStockList != null && outOfStockList.Any())
                {
                    foreach (var item in outOfStockList)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td><img src="@item.ProductImage" style="max-height: 40px;" /></td>
                            <td class="text-center text-danger font-weight-bold">Hết hàng</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-center">Tất cả sản phẩm đều đang còn hàng!</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
