@model _25DH110915_LTW.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #dff0d8; padding: 10px 15px; font-size: 26px; font-weight: 400; color: #333;">
    CHI TIẾT DANH MỤC: @Model.CategoryName
</h2>

<div class="card border-0 shadow-sm mb-4 mt-3">
    <div class="card-body">
        <p class="mb-1"><strong>Mã danh mục:</strong> #@Model.CategoryID</p>
        <p class="mb-1"><strong>Tên danh mục:</strong> @Model.CategoryName</p>
        <p class="mb-0"><strong>Tổng số hàng hóa thuộc danh mục:</strong> <span class="badge bg-primary">@(Model.Products != null ? Model.Products.Count : 0) sản phẩm</span></p>
    </div>
</div>

<h4 class="fw-bold text-success mb-3">DANH SÁCH SẢN PHẨM LIÊN QUAN THUỘC DANH MỤC</h4>

@if (Model.Products != null && Model.Products.Any())
{
    <table class="table table-bordered table-striped align-middle">
        <thead style="background-color: #dff0d8;">
            <tr>
                <th class="text-center" style="width: 100px;">Hình ảnh</th>
                <th>Tên hàng hóa</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-center">Số lượng tồn</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                string imgSrc = !string.IsNullOrEmpty(item.ProductImage)
                    ? (item.ProductImage.StartsWith("http") || item.ProductImage.StartsWith("/") || item.ProductImage.StartsWith("~")
                        ? Url.Content(item.ProductImage)
                        : Url.Content("~/Images/" + item.ProductImage))
                    : "https://via.placeholder.com/60?text=No+Image";
                <tr>
                    <td class="text-center">
                        <img src="@imgSrc" alt="@item.ProductName" style="height: 60px; max-width: 60px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/60?text=No+Image'" />
                    </td>
                    <td class="fw-bold">@item.ProductName</td>
                    <td class="text-end text-danger fw-bold">@item.ProductPrice.ToString("N0") VNĐ</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-center">
                        @Html.ActionLink("Chi tiết", "Details", "AdminProducts", new { area = "Admin", id = item.ProductID }, new { @class = "btn btn-info btn-sm me-1" })
                        @Html.ActionLink("Sửa", "Edit", "AdminProducts", new { area = "Admin", id = item.ProductID }, new { @class = "btn btn-warning btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Chưa có sản phẩm nào thuộc danh mục này.</div>
}

<p class="mt-3">
    @Html.ActionLink("Cập nhật danh mục", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary me-2" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
</p>
