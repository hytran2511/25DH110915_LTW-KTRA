@model IEnumerable<_25DH110915_LTW.Models.Category>

@{
    ViewBag.Title = "Quản lý Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #dff0d8; padding: 10px 15px; font-size: 26px; font-weight: 400; color: #333;">
    DANH SÁCH DANH MỤC SẢN PHẨM
</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-bordered table-striped mt-3">
    <thead style="background-color: #dff0d8; color: #333;">
        <tr>
            <th>TÊN DANH MỤC</th>
            <th class="text-center" style="width: 240px;">TỔNG SỐ HÀNG HÓA</th>
            <th class="text-center" style="width: 220px;">THAO TÁC</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr style="background-color: #d9edf7;">
                <td class="align-middle">
                    <a href="@Url.Action("Details", "Categories", new { area = "Admin", id = item.CategoryID })" class="fw-bold text-decoration-none text-dark" title="Xem danh sách sản phẩm thuộc danh mục">
                        @Html.DisplayFor(modelItem => item.CategoryName)
                    </a>
                </td>
                <td class="text-center align-middle fw-bold text-primary">
                    @(item.Products != null ? item.Products.Count : 0) hàng hóa
                </td>
                <td class="text-center align-middle">
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm me-1" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="mt-3">
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>
