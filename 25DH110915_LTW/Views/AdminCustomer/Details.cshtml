@model _25DH110915_LTW.Models.Customer

@{
    ViewBag.Title = "Chi tiết Khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary"><i class="fa fa-id-card"></i> HỒ SƠ KHÁCH HÀNG</h3>
        <a href="@Url.Action("Index", "AdminCustomer")" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <!-- Cột trái: Thông tin cá nhân -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-top border-info border-4 mb-4">
                <div class="card-header bg-white pb-0">
                    <h5 class="fw-bold text-info"><i class="fa fa-user"></i> THÔNG TIN CÁ NHÂN</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <img src="https://ui-avatars.com/api/?name=@Model.CustomerName&background=random&size=100" class="rounded-circle shadow-sm" alt="Avatar">
                        <h5 class="mt-3 fw-bold">@Model.CustomerName</h5>
                        <span class="badge bg-secondary">Khách hàng thành viên</span>
                    </div>
                    <hr />
                    <p class="mb-2"><i class="fa fa-hashtag text-muted me-2"></i><strong>Mã KH:</strong> #@Model.CustomerID</p>
                    <p class="mb-2"><i class="fa fa-phone text-muted me-2"></i><strong>SĐT:</strong> @Model.CustomerPhone</p>
                    <p class="mb-2"><i class="fa fa-envelope text-muted me-2"></i><strong>Email:</strong> @Model.CustomerEmail</p>
                    <p class="mb-0"><i class="fa fa-map-marker-alt text-muted me-2"></i><strong>Địa chỉ:</strong> @Model.CustomerAddress</p>
                </div>
            </div>
        </div>

        <!-- Cột phải: Lịch sử đơn hàng của khách -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="fw-bold mb-0"><i class="fa fa-history"></i> LỊCH SỬ MUA HÀNG CỦA KHÁCH</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered mb-0 align-middle text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã ĐH</th>
                                        <th>Ngày Mua</th>
                                        <th>Tổng Tiền</th>
                                        <th>Trạng Thái</th>
                                        <th>Chi Tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">#@order.OrderID</td>
                                            <td>@String.Format("{0:dd/MM/yyyy HH:mm}", order.OrderDate)</td>
                                            <td class="text-danger fw-bold">@String.Format("{0:N0}", order.TotalAmount) VNĐ</td>
                                            <td>
                                                @if (order.PaymentStatus == "Đã giao hàng")
                                                {
                                                    <span class="badge bg-success">@order.PaymentStatus</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">@order.PaymentStatus</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "AdminOrder", new { id = order.OrderID })" class="btn btn-sm btn-outline-info">
                                                    <i class="fa fa-eye"></i> Xem ĐH
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="fa fa-box-open fa-3x mb-3 opacity-50"></i>
                            <h5>Khách hàng này chưa có đơn hàng nào.</h5>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>