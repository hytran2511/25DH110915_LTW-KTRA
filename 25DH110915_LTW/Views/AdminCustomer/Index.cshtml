@model IEnumerable<_25DH110915_LTW.Models.Customer>
@{
    ViewBag.Title = "Danh sách khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary"><i class="fa fa-users"></i> DANH SÁCH KHÁCH HÀNG</h3>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã KH</th>
                        <th>Họ tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Địa chỉ</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-secondary">#@item.CustomerID</td>
                            <td class="fw-bold">@item.CustomerName</td>
                            <td class="text-center">@item.CustomerPhone</td>
                            <td>@item.CustomerEmail</td>
                            <td>@item.CustomerAddress</td>

                            <!-- NÚT XEM CHI TIẾT  -->
                            <td class="text-center">
                                <a href="@Url.Action("Details", "AdminCustomer", new { id = item.CustomerID })" class="btn btn-sm btn-outline-info">
                                    <i class="fa fa-eye"></i> Lịch sử mua hàng
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>