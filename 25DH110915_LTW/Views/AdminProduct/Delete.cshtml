@model _25DH110915_LTW.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow border-top border-danger border-4">
                <div class="card-body text-center p-5">
                    <i class="fa fa-exclamation-triangle text-danger" style="font-size: 60px;"></i>
                    <h3 class="mt-4 fw-bold">Bạn có chắc chắn muốn xóa?</h3>
                    <p class="text-muted">Sản phẩm <strong>@Model.ProductName</strong> sẽ bị xóa vĩnh viễn khỏi hệ thống và không thể khôi phục.</p>

                    <div class="mt-4 bg-light p-3 rounded text-start">
                        <p class="mb-1"><strong>ID:</strong> #@Model.ProductID</p>
                        <p class="mb-1"><strong>Giá:</strong> @String.Format("{0:N0} VNĐ", Model.ProductPrice)</p>
                        <p class="mb-0"><strong>Tồn kho:</strong> @Model.Quantity</p>
                    </div>

                    <div class="mt-5 d-flex justify-content-center gap-3">
                        <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-secondary px-4">
                            <i class="fa fa-arrow-left"></i> Quay lại
                        </a>
                        @using (Html.BeginForm("Delete", "AdminProduct", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ProductID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fa fa-trash"></i> Xác nhận Xóa
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>