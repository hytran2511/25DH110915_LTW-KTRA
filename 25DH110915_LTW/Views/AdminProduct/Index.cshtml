@model IEnumerable<_25DH110915_LTW.Models.Product>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary"><i class="fa fa-box"></i> QUẢN LÝ SẢN PHẨM</h3>

        <!-- Nút Thêm mới sản phẩm -->
        <a href="@Url.Action("Create", "AdminProduct")" class="btn btn-success px-4">
            <i class="fa fa-plus"></i> Thêm sản phẩm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-dark text-center">
                    <tr>
                        <th>ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Số lượng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td class="text-center fw-bold text-secondary">#@item.ProductID</td>

                            <td class="text-center">
                                <!-- Hiển thị hình ảnh sản phẩm (Giả sử ảnh lưu trong thư mục /Images/) -->
                                <img src="~/Images/@item.ProductImage" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: cover;" class="rounded shadow-sm" />
                            </td>

                            <td class="fw-bold">@item.ProductName</td>

                            <!-- Lấy tên danh mục từ bảng Category -->
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@(item.Category != null ? item.Category.CategoryName : "Trống")</span>
                            </td>

                            <td class="text-end fw-bold text-danger">@String.Format("{0:N0} VNĐ", item.ProductPrice)</td>

                            <td class="text-center">@item.Quantity</td>

                            <td class="text-center">
                                <a href="@Url.Action("Edit", "AdminProduct", new { id = item.ProductID })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fa fa-edit"></i> Sửa
                                </a>
                                <a href="@Url.Action("Delete", "AdminProduct", new { id = item.ProductID })" class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>