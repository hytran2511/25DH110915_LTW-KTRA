@{
    ViewBag.Title = "Tổng quan Thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <h3 class="fw-bold text-primary mb-4"><i class="fa fa-chart-line"></i> TỔNG QUAN HỆ THỐNG</h3>

    <!-- 4 THẺ THỐNG KÊ (CARDS) -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Doanh Thu</h6>
                            <h3 class="fw-bold mb-0">@String.Format("{0:N0}", ViewBag.TotalRevenue) đ</h3>
                        </div>
                        <i class="fa fa-wallet fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Đơn Hàng</h6>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalOrders</h3>
                        </div>
                        <i class="fa fa-shopping-cart fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white shadow h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Khách Hàng</h6>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalCustomers</h3>
                        </div>
                        <i class="fa fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Sản Phẩm</h6>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalProducts</h3>
                        </div>
                        <i class="fa fa-box fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG 5 ĐƠN HÀNG MỚI NHẤT -->
    <h5 class="fw-bold text-secondary mb-3"><i class="fa fa-clock"></i> Đơn hàng gần đây</h5>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.RecentOrders)
                    {
                        <tr>
                            <td class="text-center fw-bold">#@item.OrderID</td>
                            <td class="text-center">@String.Format("{0:dd/MM/yyyy HH:mm}", item.OrderDate)</td>
                            <td class="text-end fw-bold text-danger">@String.Format("{0:N0} VNĐ", item.TotalAmount)</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@item.PaymentStatus</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-end bg-white">
            <a href="@Url.Action("Index", "AdminOrder")" class="btn btn-sm btn-outline-primary">Xem tất cả đơn hàng →</a>
        </div>
    </div>
</div>