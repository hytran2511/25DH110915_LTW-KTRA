@model _25DH110915_LTW.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-primary"><i class="fa fa-info-circle"></i> CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h4>
        <a href="@Url.Action("Index", "AdminOrder")" class="btn btn-outline-secondary"><i class="fa fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="row">
        <!-- Cột trái: Thông tin khách hàng & Đơn hàng -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-top border-info border-4 mb-4">
                <div class="card-header bg-white pb-0">
                    <h6 class="fw-bold text-info"><i class="fa fa-user"></i> THÔNG TIN KHÁCH HÀNG</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Khách hàng:</strong> @Model.Customer.CustomerName</p>
                    <p class="mb-2"><strong>SĐT:</strong> @Model.Customer.CustomerPhone</p>
                    <p class="mb-2"><strong>Email:</strong> @Model.Customer.CustomerEmail</p>
                    <p class="mb-0"><strong>Địa chỉ:</strong> @Model.Customer.CustomerAddress</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 border-top border-warning border-4">
                <div class="card-header bg-white pb-0">
                    <h6 class="fw-bold text-warning"><i class="fa fa-file-invoice-dollar"></i> THÔNG TIN ĐƠN HÀNG</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Ngày đặt:</strong> @String.Format("{0:dd/MM/yyyy HH:mm}", Model.OrderDate)</p>
                    <p class="mb-2"><strong>Phương thức giao:</strong> @Model.DeliveryMethod</p>
                    <p class="mb-2"><strong>Thanh toán bằng:</strong> @Model.PaymentMethod</p>
                    <p class="mb-0">
                        <strong>Trạng thái:</strong>
                        <span class="badge bg-primary">@Model.PaymentStatus</span>
                    </p>
                </div>
            </div>
        </div>

        <!-- Cột phải: Danh sách sản phẩm trong đơn hàng -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h6 class="fw-bold mb-0"><i class="fa fa-box-open"></i> SẢN PHẨM TRONG ĐƠN</h6>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered mb-0 align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <img src="~/Images/@detail.Product.ProductImage" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                                    </td>
                                    <td class="text-start fw-bold">@detail.Product.ProductName</td>
                                    <td>@String.Format("{0:N0}", detail.UnitPrice) VNĐ</td>
                                    <td>@detail.Quantity</td>
                                    <td class="text-danger fw-bold">@String.Format("{0:N0}", detail.TotalPrice) VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white text-end py-3">
                    <h4 class="mb-0">Tổng cộng: <span class="text-danger fw-bold">@String.Format("{0:N0}", Model.TotalAmount) VNĐ</span></h4>
                </div>
            </div>
        </div>
    </div>
</div>