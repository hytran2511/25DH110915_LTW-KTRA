@model IEnumerable<_25DH110915_LTW.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary"><i class="fa fa-tasks"></i> QUẢN LÝ ĐƠN HÀNG (ADMIN)</h3>
    </div>

    <!-- THANH TÌM KIẾM  -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "AdminOrder", FormMethod.Get, new { @class = "row gx-3 gy-2 align-items-end" }))
            {
                <div class="col-sm-3">
                    <label class="form-label text-muted small">Tên khách hàng</label>
                    <input type="text" name="searchName" class="form-control" placeholder="Nhập tên..." value="@ViewBag.CurrentFilter">
                </div>
                <div class="col-sm-3">
                    <label class="form-label text-muted small">Trạng thái thanh toán</label>
                    <select name="searchStatus" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="Chờ thanh toán">Chờ thanh toán</option>
                        <option value="Đang xử lý">Đang xử lý</option>
                        <option value="Đã giao hàng">Đã giao hàng</option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label text-muted small">Ngày đặt hàng</label>
                    <input type="date" name="searchDate" class="form-control">
                </div>
                <div class="col-sm-auto">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Tìm kiếm</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            }
        </div>
    </div>

    <!-- BẢNG HIỂN THỊ ĐƠN HÀNG -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Ngày Đặt</th>
                            <th>Khách Hàng</th>
                            <th>Thanh Toán</th>
                            <th>Giao Hàng</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">#@item.OrderID</td>
                                <td class="text-center">@String.Format("{0:dd/MM/yyyy HH:mm}", item.OrderDate)</td>

                                <td>@item.Customer.CustomerName</td>

                                <td class="text-center">
                                    @if (item.PaymentMethod == "Paypal")
                                    {
                                        <span class="badge bg-primary"><i class="fab fa-paypal"></i> PayPal</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fa fa-money-bill"></i> Tiền mặt</span>
                                    }
                                </td>

                                <td class="text-center">@item.DeliveryMethod</td>
                                <td class="text-end fw-bold text-danger">@String.Format("{0:N0} VNĐ", item.TotalAmount)</td>

                                <td class="text-center">
                                    @if (item.PaymentStatus == "Pending" || item.PaymentStatus == "Chờ thanh toán")
                                    {
                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    }
                                    else if (item.PaymentStatus == "Processing" || item.PaymentStatus == "Đang xử lý")
                                    {
                                        <span class="badge bg-info text-dark">Đang xử lý</span>
                                    }
                                    else if (item.PaymentStatus == "Shipped" || item.PaymentStatus == "Đang vận chuyển")
                                    {
                                        <span class="badge bg-primary">Đang vận chuyển</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Đã giao hàng</span>
                                    }
                                </td>

                                <td class="text-center text-nowrap">
                                    <a href="@Url.Action("UpdateStatus", "AdminOrder", new { id = item.OrderID })" class="btn btn-sm btn-outline-primary" title="Cập nhật trạng thái">
                                        <i class="fa fa-edit"></i> Xử lý
                                    </a>
                                    <!-- Nút xem Chi tiết -->
                                    <a href="@Url.Action("Details", "AdminOrder", new { id = item.OrderID })" class="btn btn-sm btn-outline-info ms-1" title="Xem chi tiết">
                                        <i class="fa fa-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>