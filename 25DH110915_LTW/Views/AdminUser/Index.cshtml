@model IEnumerable<_25DH110915_LTW.Models.User>
@{
    ViewBag.Title = "Quản lý Người Dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary"><i class="fa fa-user-shield"></i> TÀI KHOẢN QUẢN TRỊ (ADMIN)</h3>
        <a href="@Url.Action("Create", "AdminUser")" class="btn btn-success px-4">
            <i class="fa fa-plus"></i> Cấp tài khoản mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Tên Đăng Nhập</th>
                        <th>Mật Khẩu</th>
                        <th>Quyền Hạn (Role)</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-primary">@item.Username</td>
                            <td class="text-center">
                                <!-- Che bớt mật khẩu cho chuyên nghiệp -->
                                @(new String('*', item.Password != null ? item.Password.Length : 0))
                            </td>
                            <td class="text-center">
                                <span class="badge bg-danger fs-6">@item.UserRole</span>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Edit", "AdminUser", new { id = item.Username })" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="fa fa-edit"></i> Sửa
                                </a>
                                <a href="@Url.Action("Delete", "AdminUser", new { id = item.Username })" class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>