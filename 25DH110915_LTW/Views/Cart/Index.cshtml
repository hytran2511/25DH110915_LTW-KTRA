@model _25DH110915_LTW.Models.Cart
@using System
@using System.Linq

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <h2 class="text-danger fw-bold"><i class="fa fa-shopping-cart me-2"></i>GIỎ HÀNG CỦA BẠN</h2>
    <hr />

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-triangle me-1"></i> @TempData["CartError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0 align-middle">
                    <thead class="bg-danger text-white">
                        <tr>
                            <th class="text-center" style="width: 110px;">Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-center" style="width: 240px;">Số lượng</th>
                            <th class="text-center">Thành tiền</th>
                            <th class="text-center" style="width: 110px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            string imgSrc = !string.IsNullOrEmpty(item.ProductImage)
                                ? (item.ProductImage.StartsWith("http") || item.ProductImage.StartsWith("/") || item.ProductImage.StartsWith("~")
                                    ? Url.Content(item.ProductImage)
                                    : Url.Content("~/Images/" + item.ProductImage))
                                : "https://via.placeholder.com/80?text=No+Image";
                            int maxQty = item.MaxQuantity > 0 ? item.MaxQuantity : 99;

                            <tr>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", "Products", new { id = item.ProductID })">
                                        <img src="@imgSrc" alt="@item.ProductName" style="height: 75px; max-width: 75px; object-fit: contain; border-radius: 4px;" onerror="this.src='https://via.placeholder.com/80?text=No+Image'" />
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "Products", new { id = item.ProductID })" class="fw-bold text-dark text-decoration-none">
                                        @item.ProductName
                                    </a>
                                    <div class="small text-muted mt-1">Kho còn: <strong>@maxQty</strong> sản phẩm</div>
                                </td>
                                <td class="text-center">@item.Price.ToString("N0") VNĐ</td>
                                <td class="text-center">
                                    @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-inline-flex align-items-center justify-content-center gap-1" }))
                                    {
                                        <input type="hidden" name="id" value="@item.ProductID" />
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-max="@maxQty" onclick="changeCartQty(this, -1)">-</button>
                                        <input type="number" name="newQuantity" value="@item.Quantity" class="form-control form-control-sm text-center" style="width: 65px;" min="1" max="@maxQty" data-max="@maxQty" onchange="validateAndSubmitQty(this)" />
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-max="@maxQty" onclick="changeCartQty(this, 1)">+</button>
                                        <button type="submit" class="btn btn-sm btn-info text-white ms-1">Cập nhật</button>
                                    }
                                </td>
                                <td class="text-center text-danger fw-bold">
                                    @item.TotalPrice.ToString("N0") VNĐ
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                        <i class="fa fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end"><strong>Tổng số lượng:</strong></td>
                            <td class="text-center fw-bold">@Model.TotalQuantity() sản phẩm</td>
                            <td class="text-center text-danger fw-bold fs-5">
                                @Model.TotalCartValue().ToString("N0") VNĐ
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="@Url.Action("Index", "Products")" class="btn btn-secondary px-4">
                <i class="fa fa-arrow-left me-1"></i> Tiếp tục mua hàng
            </a>
            <a href="@Url.Action("Checkout", "Order")" class="btn btn-danger btn-lg px-5 fw-bold">
                Thanh toán <i class="fa fa-arrow-right ms-1"></i>
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center p-5 shadow-sm">
            <i class="fa fa-shopping-basket fa-3x text-warning mb-3"></i>
            <h4>Giỏ hàng của bạn đang trống!</h4>
            <p class="text-muted">Hãy chọn thêm sản phẩm vào giỏ hàng trước khi thanh toán.</p>
            <a href="@Url.Action("Index", "Products")" class="btn btn-primary px-4 mt-2">
                <i class="fa fa-shopping-bag me-1"></i> Tiếp tục mua hàng
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        function changeCartQty(btn, delta) {
            var maxQty = parseInt(btn.getAttribute('data-max')) || 99;
            var form = btn.closest('form');
            var input = form.querySelector('input[name="newQuantity"]');
            var val = parseInt(input.value) || 1;
            var nextVal = val + delta;
            if (nextVal < 1) {
                alert('Số lượng không được nhỏ hơn 1!');
                nextVal = 1;
            }
            if (nextVal > maxQty) {
                alert('Số lượng mua không được vượt quá số lượng tồn kho (' + maxQty + ')!');
                nextVal = maxQty;
            }
            input.value = nextVal;
            form.submit();
        }

        function validateAndSubmitQty(input) {
            var maxQty = parseInt(input.getAttribute('data-max')) || 99;
            var val = parseInt(input.value);
            if (isNaN(val) || val < 1) {
                alert('Số lượng phải lớn hơn 0!');
                input.value = 1;
            } else if (val > maxQty) {
                alert('Số lượng vượt quá tồn kho (' + maxQty + ')!');
                input.value = maxQty;
            }
            input.closest('form').submit();
        }
    </script>
}
