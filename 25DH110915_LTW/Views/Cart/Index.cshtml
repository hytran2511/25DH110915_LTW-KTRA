@model _25DH110915_LTW.Models.Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    <h2 class="text-danger">GIỎ HÀNG CỦA BẠN</h2>
    <hr />

    @if (Model != null && Model.Items.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="bg-danger text-white">
                <tr>
                    <th class="text-center">Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-center">Đơn giá</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-center">Thành tiền</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" style="height: 80px; border-radius: 4px;" />
                        </td>
                        <td style="vertical-align: middle;">@item.ProductName</td>
                        <td class="text-center" style="vertical-align: middle;">@item.Price.ToString("N0") VNĐ</td>
                        <td class="text-center" style="vertical-align: middle;">
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <!-- Gửi ngầm ProductID để Controller biết đang cập nhật món nào -->
                                <input type="hidden" name="id" value="@item.ProductID" />

                                <!-- Ô nhập số lượng mới (tên biến newQuantity khớp với tham số trong Controller) -->
                                <input type="number" name="newQuantity" value="@item.Quantity" class="form-control" style="width: 80px; display: inline-block; text-align: center;" min="1" />

                                <!-- Nút bấm để gửi form -->
                                <button type="submit" class="btn btn-sm btn-info" style="margin-top: 5px;">Cập nhật</button>
                            }
                        </td>
                        <td class="text-center" style="vertical-align: middle; color: red; font-weight: bold;">
                            @item.TotalPrice.ToString("N0") VNĐ
                        </td>
                        <td class="text-center" style="vertical-align: middle;">
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end"><strong>Tổng cộng:</strong></td>
                    <td class="text-center" style="color: red; font-size: 1.2em; font-weight: bold;">
                        @Model.TotalCartValue().ToString("N0") VNĐ
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <div class="text-end" style="margin-top: 20px;">
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Tiếp tục mua sắm</a>
            <a href="@Url.Action("Checkout", "Order")" class="btn btn-danger">Thanh toán</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            <h4>Giỏ hàng của bạn đang trống!</h4>
            <br />
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Quay lại mua sắm</a>
        </div>
    }
</div>