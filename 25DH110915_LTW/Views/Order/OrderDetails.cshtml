@model _25DH110915_LTW.Models.Order
@{
    ViewBag.Title = "Hóa đơn mua hàng #" + Model.OrderID;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="bg-white p-4 rounded shadow-sm">
        <!-- Dùng chung Partial View Hóa đơn mua hàng với trang Detail của Quản lý đơn hàng (Admin) -->
        @Html.Partial("~/Views/Shared/_OrderInvoicePartial.cshtml", Model)

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i> Quay lại Lịch sử mua hàng
            </a>
            <a href="@Url.Action("BuyAgain", "Order", new { id = Model.OrderID })" class="btn btn-primary">
                <i class="fa fa-cart-plus me-1"></i> Mua lại đơn hàng này
            </a>
        </div>
    </div>
</div>
