@model _25DH110915_LTW.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-info"><i class="fa fa-info-circle"></i> CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h3>
        <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-secondary"><i class="fa fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Trạng thái:</strong> <span class="badge bg-warning text-dark">@Model.PaymentStatus</span></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Giao hàng:</strong> @Model.DeliveryMethod</p>
                    <p><strong>Địa chỉ nhận:</strong> @Model.ShippingAddress</p>
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3">Sản phẩm đã mua</h5>
    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-info">
            <tr>
                <th>Mã SP</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>SP-@item.ProductID</td>
                    <td class="text-center">@item.Quantity</td>
                    <td>@String.Format("{0:N0}", item.UnitPrice) đ</td>
                    <td class="text-danger fw-bold">@String.Format("{0:N0}", item.TotalPrice) đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold fs-5">TỔNG CỘNG:</td>
                <td class="text-danger fw-bold fs-5">@String.Format("{0:N0}", Model.TotalAmount) đ</td>
            </tr>
        </tfoot>
    </table>
</div>