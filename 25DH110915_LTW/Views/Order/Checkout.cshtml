@model _25DH110915_LTW.Models.ViewModel.CheckoutVM
@{
    ViewBag.Title = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function enableAddressEdit() {
        document.getElementById("shippingAddress").removeAttribute("readonly");
        document.getElementById("newAddressGroup").style.display = "block";
    }
    function updateShippingAddress() {
        var newAddress = document.getElementById("newShippingAddress").value;
        if (newAddress) {
            document.getElementById("shippingAddress").value = newAddress;
        }
    }
</script>

<div class="container mt-4 mb-5">
    <h2 class="text-primary fw-bold mb-4"><i class="fa fa-credit-card me-2"></i>THANH TOÁN ĐƠN HÀNG</h2>

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="alert alert-warning text-center p-4">
            <h5>Giỏ hàng của bạn đang trống, không thể thanh toán!</h5>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2">Tiếp tục mua hàng</a>
        </div>
    }
    else
    {
        using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CustomerID)
            @Html.HiddenFor(m => m.Username)

            <div class="row">
                <!-- Cột trái: Danh sách hàng & Phương thức giao hàng / thanh toán -->
                <div class="col-md-7 mb-4">
                    <div class="card border-0 shadow-sm p-4 mb-4">
                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Danh sách sản phẩm đặt mua</h5>
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@String.Format("{0:N0}", item.Price) đ</td>
                                        <td class="text-end fw-bold text-danger">@String.Format("{0:N0}", item.TotalPrice) đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Tổng tiền thanh toán:</td>
                                    <td class="text-end text-danger fw-bold fs-5">@String.Format("{0:N0}", Model.TotalAmount) đ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="card border-0 shadow-sm p-4">
                        <div class="form-group mb-3">
                            <label class="fw-bold mb-2">Phương thức giao hàng</label><br />
                            <label class="me-4">
                                @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" }) Giao hàng nhanh
                            </label>
                            <label>
                                @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm") Giao hàng tiết kiệm
                            </label>
                        </div>

                        <div class="form-group mb-2">
                            <label class="fw-bold mb-2">Phương thức thanh toán</label><br />
                            <div class="mb-1">
                                @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" }) Thanh toán tiền mặt khi nhận hàng (COD)
                            </div>
                            <div class="mb-1">
                                @Html.RadioButtonFor(m => m.PaymentMethod, "Paypal") Thanh toán qua PayPal
                            </div>
                            <div>
                                @Html.RadioButtonFor(m => m.PaymentMethod, "Mua trước trả sau") Mua trước trả sau
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Thông tin thanh toán của người dùng đang đăng nhập -->
                <div class="col-md-5">
                    <div class="card p-4 shadow-sm border-0">
                        <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">
                            <i class="fa fa-user-check me-2"></i>Thông tin thanh toán & nhận hàng
                        </h5>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Họ tên khách hàng</label>
                            @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control bg-light", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Số điện thoại liên hệ</label>
                            @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control bg-light", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Email</label>
                            @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control bg-light", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.ShippingAddress, new { @class = "form-label fw-bold text-muted small" })
                            @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", @readonly = "readonly", id = "shippingAddress" })
                            <button type="button" class="btn btn-sm btn-link px-0 mt-1" onclick="enableAddressEdit()">
                                <i class="fa fa-edit"></i> Thay đổi địa chỉ giao hàng khác
                            </button>
                        </div>

                        <div class="mb-3" id="newAddressGroup" style="display:none;">
                            <label class="form-label text-primary fw-bold small">Nhập địa chỉ giao hàng mới</label>
                            <input type="text" id="newShippingAddress" name="newShippingAddress" class="form-control border-primary" placeholder="Nhập số nhà, tên đường, phường/xã, quận/huyện..." />
                        </div>

                        <button type="submit" class="btn btn-danger w-100 fw-bold py-2 mt-2" onclick="updateShippingAddress()">
                            <i class="fa fa-check-circle me-1"></i> XÁC NHẬN ĐẶT HÀNG (@String.Format("{0:N0}", Model.TotalAmount) đ)
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>
