@model _25DH110915_LTW.Models.Order
@{
    ViewBag.Title = "Xác nhận đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <h2 class="text-success fw-bold text-center mb-4"><i class="fa fa-check-circle"></i> XÁC NHẬN ĐƠN HÀNG THÀNH CÔNG</h2>

    <div class="row">
        <div class="col-md-5">
            <div class="card p-3 shadow-sm">
                <h4 class="fw-bold text-info border-bottom pb-2">Thông tin đơn hàng</h4>
                <p><strong>Mã đơn hàng:</strong> <span class="badge bg-success">#@Model.OrderID</span></p>
                <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Phương thức giao hàng:</strong> @Model.DeliveryMethod</p>
                <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
                <p><strong>Trạng thái:</strong> <span class="text-warning fw-bold">@Model.PaymentStatus</span></p>
                <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
                <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold fs-5">@String.Format("{0:N0}", Model.TotalAmount) đ</span></p>
            </div>
        </div>

        <div class="col-md-7">
            <h4 class="fw-bold text-info mb-3">Chi tiết sản phẩm</h4>
            <table class="table table-bordered shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>Mã SP</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Tổng giá</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>SP-@item.ProductID</td>
                            <td>@item.Quantity</td>
                            <td>@String.Format("{0:N0}", item.UnitPrice) đ</td>
                            <td>@String.Format("{0:N0}", item.TotalPrice) đ</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="text-end mt-4">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary"><i class="fa fa-home"></i> Trở về Trang chủ</a>
                
                <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-secondary ms-2"><i class="fa fa-history"></i> Xem đơn hàng của tôi</a>
            </div>
        </div>
    </div>
</div>