@model _25DH110915_LTW.Models.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="alert alert-success text-center py-4 shadow-sm">
        <h3 class="fw-bold mb-1"><i class="fa fa-check-circle me-2"></i>ĐẶT HÀNG THÀNH CÔNG!</h3>
        <p class="mb-0">Cảm ơn bạn đã mua sắm tại MyStore. Đơn hàng <strong>#@Model.OrderID</strong> đã được lưu và cập nhật tồn kho.</p>
    </div>

    <div class="bg-white p-4 rounded shadow-sm">
        @Html.Partial("~/Views/Shared/_OrderInvoicePartial.cshtml", Model)

        <div class="text-end mt-3 border-top pt-3">
            <h4 class="fw-bold">Tổng thanh toán: <span class="text-danger">@String.Format("{0:N0}", Model.TotalAmount) VNĐ</span></h4>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
                <i class="fa fa-home me-1"></i> Tiếp tục mua hàng
            </a>
            <a href="@Url.Action("MyOrder", "Order")" class="btn btn-primary">
                <i class="fa fa-receipt me-1"></i> Xem lịch sử giao dịch (Đơn hàng của tôi)
            </a>
        </div>
    </div>
</div>
