@model _25DH110915_LTW.Models.Product

@{
    string imgSrc = Model != null && !string.IsNullOrEmpty(Model.ProductImage)
        ? (Model.ProductImage.StartsWith("http") || Model.ProductImage.StartsWith("/") || Model.ProductImage.StartsWith("~")
            ? Url.Content(Model.ProductImage)
            : Url.Content("~/Images/" + Model.ProductImage))
        : "https://via.placeholder.com/300x400?text=No+Image";
    int soldQty = Model != null && Model.OrderDetails != null ? Model.OrderDetails.Sum(od => (int?)od.Quantity) ?? 0 : 0;
}

<div class="row g-0">
    <!-- Cột chứa hình ảnh -->
    <div class="col-md-4 p-4 text-center bg-light border-end d-flex align-items-center justify-content-center">
        <img src="@imgSrc" alt="@Model.ProductName" class="img-fluid rounded shadow-sm" style="max-height: 320px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/300x400?text=No+Image'" />
    </div>
    <!-- Cột chứa thông tin đầy đủ của sản phẩm -->
    <div class="col-md-8 p-4">
        <h3 class="text-primary mb-3 fw-bold">@Html.DisplayFor(model => model.ProductName)</h3>

        <table class="table table-borderless mb-0">
            <tbody>
                <tr>
                    <th style="width: 30%; color: #7f8c8d;">Mã sản phẩm:</th>
                    <td class="fw-bold">#@Model.ProductID</td>
                </tr>
                <tr>
                    <th style="color: #7f8c8d;">Chủng loại / Danh mục:</th>
                    <td class="fw-bold">@(Model.Category != null ? Model.Category.CategoryName : "") (Mã DM: @Model.CategoryID)</td>
                </tr>
                <tr>
                    <th style="color: #7f8c8d;">Giá bán:</th>
                    <td><span class="badge bg-danger" style="font-size: 1.15rem;">@String.Format("{0:N0}", Model.ProductPrice) VNĐ</span></td>
                </tr>
                <tr>
                    <th style="color: #7f8c8d;">Số lượng tồn kho:</th>
                    <td>
                        @if ((Model.Quantity ?? 0) > 0)
                        {
                            <span class="badge bg-success">@Model.Quantity sản phẩm (Còn hàng)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Hết hàng (0)</span>
                        }
                        <span class="ms-3 text-muted">Đã bán: <strong>@soldQty</strong></span>
                    </td>
                </tr>
                <tr>
                    <th style="color: #7f8c8d;">Mô tả chi tiết:</th>
                    <td style="line-height: 1.6; text-align: justify;">@Html.DisplayFor(model => model.ProductDecription)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
