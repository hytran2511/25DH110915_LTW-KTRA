@model _25DH110915_LTW.Models.Product

<div class="row g-0">
    <!-- Cột chứa hình ảnh -->
    <div class="col-md-4 p-4 text-center bg-light border-end d-flex align-items-center justify-content-center">
        <img src="~/Images/@Model.ProductImage" alt="@Model.ProductName" class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/300x400?text=No+Image'" />
    </div>
    <!-- Cột chứa thông tin -->
    <div class="col-md-8 p-4">
        <h3 class="text-primary mb-3 fw-bold">@Html.DisplayFor(model => model.ProductName)</h3>

        <table class="table table-borderless mb-0">
            <tbody>
                <tr>
                    <th style="width: 30%; color: #7f8c8d;">Danh mục:</th>
                    <td class="fw-bold">@Html.DisplayFor(model => model.Category.CategoryName) (ID: @Model.CategoryID)</td>
                </tr>
                <tr>
                    <th style="color: #7f8c8d;">Giá bán:</th>
                    <td><span class="badge bg-success" style="font-size: 1.1rem;">@String.Format("{0:N0}", Model.ProductPrice) VNĐ</span></td>
                </tr>
                <tr>
                    <th style="color: #7f8c8d;">Mô tả:</th>
                    <td style="line-height: 1.6; text-align: justify;">@Html.DisplayFor(model => model.ProductDecription)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
