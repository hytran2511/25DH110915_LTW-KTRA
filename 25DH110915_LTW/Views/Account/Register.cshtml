@model _25DH110915_LTW.Models.Customer
@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="fa fa-user-plus me-2"></i>ĐĂNG KÝ TÀI KHOẢN MỚI</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.ErrorRegister != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-triangle me-1"></i> @ViewBag.ErrorRegister
                    </div>
                }

                @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <!-- Khu vực tạo Tài khoản (Bảng User) -->
                    <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">Thông tin đăng nhập</h6>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
                        <input type="text" name="txtUsername" class="form-control" minlength="3" maxlength="50" placeholder="Từ 3 - 50 ký tự (VD: trangiahy)..." required />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" name="txtPassword" class="form-control" minlength="3" maxlength="50" placeholder="Nhập mật khẩu..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" name="txtConfirmPassword" class="form-control" minlength="3" maxlength="50" placeholder="Xác nhận mật khẩu..." required />
                        </div>
                    </div>

                    <!-- Khu vực Thông tin cá nhân (Bảng Customer) -->
                    <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">Thông tin cá nhân</h6>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CustomerName, new { @class = "form-label fw-bold" }) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "Nhập họ tên đầy đủ...", required = "required", minlength = "2", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CustomerPhone, new { @class = "form-label fw-bold" }) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", placeholder = "Nhập số điện thoại (7-15 số)...", required = "required", minlength = "7", maxlength = "15" })
                        @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CustomerEmail, new { @class = "form-label fw-bold" }) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email", placeholder = "example@gmail.com", required = "required" })
                        @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-4">
                        @Html.LabelFor(m => m.CustomerAddress, new { @class = "form-label fw-bold" }) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control", placeholder = "Nhập địa chỉ giao hàng...", required = "required" })
                        @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">Đăng Ký Tài Khoản</button>
                }
                <div class="text-center mt-3">
                    Đã có tài khoản? <a href="@Url.Action("Login", "Account")" class="text-decoration-none fw-bold">Đăng nhập ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
