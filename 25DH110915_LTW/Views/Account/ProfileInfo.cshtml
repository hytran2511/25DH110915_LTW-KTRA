@model _25DH110915_LTW.Models.Customer

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <!-- CỘT TRÁI: SIDEBAR MENU -->
        <div class="col-md-3">
            <div class="d-flex align-items-center mb-4">
                <img src="https://ui-avatars.com/api/?name=@Model.CustomerName&background=random&color=fff&size=50" class="rounded-circle me-3" alt="Avatar">
                <div>
                    <small class="text-muted mb-0">Tài khoản của</small>
                    <h6 class="mb-0 fw-bold">@Model.CustomerName</h6>
                </div>
            </div>

            <div class="list-group list-group-flush" style="border-radius: 8px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
                <a href="@Url.Action("ProfileInfo", "Account")" class="list-group-item list-group-item-action bg-light text-primary fw-bold border-0">
                    <i class="fa fa-user text-secondary me-2"></i> Thông tin tài khoản
                </a>
                <a href="@Url.Action("MyOrder", "Order")" class="list-group-item list-group-item-action text-secondary border-0">
                    <i class="fa fa-clipboard-list me-2"></i> Quản lý đơn hàng
                </a>
                <a href="@Url.Action("AddressBook", "Account")" class="list-group-item list-group-item-action text-secondary border-0">
                    <i class="fa fa-map-marker-alt me-2"></i> Sổ địa chỉ
                </a>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM CHỈNH SỬA THÔNG TIN -->
        <div class="col-md-9">
            <h4 class="mb-4 fw-light">Thông tin tài khoản</h4>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                <div class="row">
                    <!-- Nửa trái: Thông tin cá nhân -->
                    <div class="col-md-7 border-end pe-4">
                        <h6 class="text-muted mb-3">Thông tin cá nhân</h6>

                        <div class="mb-3 row align-items-center">
                            <label class="col-sm-3 col-form-label text-muted">Họ & Tên</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", required = "required" })
                            </div>
                        </div>

                        <div class="mb-3 row align-items-center">
                            <label class="col-sm-3 col-form-label text-muted">Địa chỉ</label>
                            <div class="col-sm-9">
                                @Html.TextAreaFor(m => m.CustomerAddress, new { @class = "form-control", rows = "2" })
                            </div>
                        </div>

                        <div class="mb-3 row align-items-center">
                            <label class="col-sm-3 col-form-label text-muted">Username</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" value="@Model.Username" disabled />
                                <small class="text-danger">Tên đăng nhập không thể thay đổi.</small>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary px-4 py-2">Lưu thay đổi</button>
                        </div>
                    </div>

                    <!-- Nửa phải: Số điện thoại và Email -->
                    <div class="col-md-5 ps-4">
                        <h6 class="text-muted mb-3">Số điện thoại và Email</h6>

                        <div class="mb-3 row align-items-center">
                            <label class="col-sm-3 col-form-label text-muted"><i class="fa fa-phone-alt"></i> SĐT</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", placeholder = "Nhập số điện thoại..." })
                            </div>
                        </div>

                        <div class="mb-4 row align-items-center border-bottom pb-4">
                            <label class="col-sm-3 col-form-label text-muted"><i class="fa fa-envelope"></i> Email</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email", placeholder = "Nhập địa chỉ email..." })
                            </div>
                        </div>

                        <h6 class="text-muted mb-3 mt-4">Bảo mật</h6>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-lock text-secondary me-2"></i>
                                <span>Đổi mật khẩu</span>
                            </div>
                            <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary btn-sm">Cập nhật</a>
                        </div>
                    </div>
                </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>