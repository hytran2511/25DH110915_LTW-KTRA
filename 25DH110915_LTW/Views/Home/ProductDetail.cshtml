@model _25DH110915_LTW.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    <div class="row">
        <!-- Cột hình ảnh sản phẩm -->
        <div class="col-md-5 text-center">
            <img src="@Url.Content(Model.ProductImage)" alt="@Model.ProductName" class="img-responsive" style="max-width: 100%; border: 1px solid #ddd; padding: 10px; border-radius: 5px;" />
        </div>

        <!-- Cột thông tin sản phẩm -->
        <div class="col-md-7">
            <h2 class="text-primary">@Model.ProductName</h2>
            <hr />

            <p><strong>Danh mục:</strong> @Model.Category.CategoryName</p>
            <p><strong>Giá bán:</strong> <span class="text-danger" style="font-size: 24px; font-weight: bold;">@Model.ProductPrice.ToString("N0") VNĐ</span></p>

            <br />
            <p><strong>Mô tả chi tiết:</strong></p>
            <p style="text-align: justify; line-height: 1.6;">
                @Html.DisplayFor(model => model.ProductDecription)
            </p>

            <br />
            <!-- Nút Thêm vào giỏ hàng ĐÃ KÍCH HOẠT -->
            <a href="@Url.Action("AddToCart", "Cart", new { id = Model.ProductID })" class="btn btn-danger btn-lg">
                <i class="glyphicon glyphicon-shopping-cart"></i> Thêm vào giỏ hàng
            </a>

            <a href="@Url.Action("Index", "Home")" class="btn btn-default btn-lg">
                Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>