@model _25DH110915_LTW.Models.Category

@{
    ViewBag.Title = "Xóa Danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow border-top border-danger border-4">
                <div class="card-body text-center p-5">
                    <i class="fa fa-exclamation-triangle text-danger" style="font-size: 60px;"></i>
                    <h3 class="mt-4 fw-bold">Xác nhận xóa?</h3>
                    <p class="text-muted">Bạn sắp xóa danh mục <strong>@Model.CategoryName</strong>. Không thể khôi phục thao tác này.</p>

                    <div class="mt-4 bg-light p-3 rounded text-start">
                        <p class="mb-1"><strong>Mã Danh Mục:</strong> #@Model.CategoryID</p>
                        <p class="mb-0"><strong>Tên Danh Mục:</strong> @Model.CategoryName</p>
                    </div>

                    <div class="mt-5 d-flex justify-content-center gap-3">
                        <a href="@Url.Action("Index", "AdminCategory")" class="btn btn-secondary px-4">
                            <i class="fa fa-arrow-left"></i> Hủy
                        </a>
                        @using (Html.BeginForm("Delete", "AdminCategory", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.CategoryID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fa fa-trash"></i> Xác nhận Xóa
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>