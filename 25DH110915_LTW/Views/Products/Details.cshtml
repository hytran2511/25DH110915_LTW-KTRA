@model _25DH110915_LTW.Models.Product

@{
    ViewBag.Title = Model.ProductName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int maxStock = Model.Quantity ?? 0;
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @Html.Partial("~/Views/Shared/_ProductDetailPartial.cshtml", Model)
        </div>

        <div class="card-footer bg-white py-4 px-4">
            @if (maxStock > 0)
            {
                using (Html.BeginForm("AddToCart", "Cart", FormMethod.Get, new { @class = "d-flex flex-wrap align-items-center justify-content-center gap-3" }))
                {
                    <input type="hidden" name="id" value="@Model.ProductID" />

                    <div class="d-flex align-items-center gap-2">
                        <label class="fw-bold text-secondary mb-0">Số lượng mua:</label>
                        <div class="input-group" style="width: 140px;">
                            <button type="button" class="btn btn-outline-secondary" data-max="@maxStock" onclick="stepDetailQty(this, -1)">-</button>
                            <input type="number" id="buyQuantityInput" name="quantity" value="1" min="1" max="@maxStock" class="form-control text-center fw-bold" />
                            <button type="button" class="btn btn-outline-secondary" data-max="@maxStock" onclick="stepDetailQty(this, 1)">+</button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg fw-bold px-4">
                        <i class="fa fa-cart-plus me-2"></i> MUA HÀNG / THÊM VÀO GIỎ
                    </button>

                    <a href="@Url.Action("Index", "Products", new { categoryId = Model.CategoryID })" class="btn btn-outline-secondary btn-lg px-4">
                        Quay lại danh mục
                    </a>
                }
            }
            else
            {
                <div class="text-center">
                    <span class="btn btn-secondary btn-lg disabled me-3">Sản phẩm tạm hết hàng</span>
                    <a href="@Url.Action("Index", "Products")" class="btn btn-outline-primary btn-lg">Xem sản phẩm khác</a>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        function stepDetailQty(btn, delta) {
            var maxStock = parseInt(btn.getAttribute('data-max')) || 99;
            var input = document.getElementById('buyQuantityInput');
            var val = parseInt(input.value) || 1;
            var next = val + delta;
            if (next < 1) next = 1;
            if (next > maxStock) {
                alert('Số lượng tồn kho chỉ còn ' + maxStock + ' sản phẩm!');
                next = maxStock;
            }
            input.value = next;
        }
    </script>
}
